# RPLIDAR A1M8 (CP2102 / CH340) 固定设备名
# 安装：sudo cp 99-rplidar.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
# 之后即可用 /dev/rplidar 访问，避免 ttyUSB* 编号漂移
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE="0666", SYMLINK+="rplidar"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", MODE="0666", SYMLINK+="rplidar"
